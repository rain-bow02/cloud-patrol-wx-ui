{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": "."
  },
  "include": [
    "mobile/**/*.ts",
    "mobile/**/*.vue",
    "api/**/*.ts",
    "model/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
